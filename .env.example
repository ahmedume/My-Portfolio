# GROQ_API_KEY: Required for Groq Chatbot.
# Obtain a key from https://console.groq.com and paste it here.
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: The URL where this application is hosted.
# For local development, this defaults to http://localhost:3000
APP_URL="http://localhost:3000"

# NODE_ENV: Set to "production" for production builds.
# NODE_ENV="production"

# DISABLE_HMR: Set to "true" to disable Hot Module Replacement.
# DISABLE_HMR="true"
